{
  "name": "@veil/arbitrage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fee-, depth- and funding-aware arbitrage opportunity scanner across Bitget, Binance, Bybit and OKX",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "arb-scan": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "scan": "npm run build && node dist/cli.js",
    "scan:demo": "npm run build && node dist/cli.js --demo"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
