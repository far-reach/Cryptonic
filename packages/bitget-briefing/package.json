{
  "name": "@veil/bitget-briefing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bot that reads the Bitget announcement center and produces a critical daily briefing",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "bitget-briefing": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "briefing": "npm run build && node dist/cli.js",
    "briefing:demo": "npm run build && node dist/cli.js --demo"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
