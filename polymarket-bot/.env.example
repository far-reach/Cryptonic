# Copy this file to `.env` in the project root and fill it in.
# polybot auto-loads `.env` on startup (no `source`/direnv needed) — this
# works on Windows, macOS and Linux. NEVER commit the real .env file.

# --- live trading only -------------------------------------------------
# Wallet private key that controls your Polymarket funds (0x-prefixed).
POLYMARKET_PRIVATE_KEY=

# Your Polymarket proxy wallet address (Profile -> copy address).
# Leave empty if you trade from a plain EOA that holds the USDC itself.
POLYMARKET_FUNDER_ADDRESS=

# 0 = plain EOA, 1 = email/Magic login, 2 = browser wallet (MetaMask etc.)
POLYMARKET_SIGNATURE_TYPE=2

# Explicit opt-in gate for real orders:
# POLYBOT_LIVE_ACK=I_UNDERSTAND_THE_RISKS
